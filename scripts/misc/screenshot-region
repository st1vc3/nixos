#!/usr/bin/env bash
# Alt+Shift+4: select a region and copy it to the Wayland clipboard.
set -euo pipefail

for command in grim slurp wl-copy wl-paste notify-send; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'screenshot-region: required command is missing: %s\n' "$command" >&2
    exit 1
  fi
done

# Slurp exits non-zero when Escape is pressed. Cancellation is expected and
# should not produce a failure notification.
if ! selection="$(slurp)" || [ -z "$selection" ]; then
  exit 0
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
temporary_image="$(mktemp --tmpdir="$runtime_dir" screenshot-region.XXXXXX.png)"
trap 'rm -f -- "$temporary_image"' EXIT HUP INT TERM

if ! grim -g "$selection" "$temporary_image"; then
  notify-send -u critical "Screenshot failed" "Could not capture the selected region"
  exit 1
fi

if ! wl-copy --type image/png <"$temporary_image"; then
  notify-send -u critical "Screenshot failed" "Could not copy the image to the clipboard"
  exit 1
fi

if ! wl-paste --list-types | grep -Fxq 'image/png'; then
  notify-send -u critical "Screenshot failed" "The clipboard did not retain the PNG image"
  exit 1
fi
