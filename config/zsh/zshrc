# Powerful but minimal zsh configuration
# Author: Radley E. Sidwell-Lewis
# GitHub: https://www.github.com/radleylewis/zsh
#
# Uses:
#   Plugins:      fast-syntax-highlighting, zsh-autosuggestions,
#                 zsh-history-substring-search, zsh-vi-mode
#   Prompt:       starship
#   Navigation:   zoxide, fzf, fd
#   CLI tools:    eza, bat, nvim, ripgrep
#   Node:         nvm

# Environment (XDG dirs, editor, starship config, PATH)
source "$ZDOTDIR/zshenv"

# =========================================================
# History
# =========================================================

mkdir -p "$XDG_STATE_HOME/zsh" "$XDG_CACHE_HOME/zsh"

HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS

# =========================================================
# Shell behaviour
# =========================================================

setopt AUTOCD
setopt NOBEEP
setopt NUMERIC_GLOB_SORT  # sort file10 after file9, not after file1

# =========================================================
# Smart directory navigation
# =========================================================

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# =========================================================
# Completion
# =========================================================

autoload -Uz compinit compaudit

# Ignore completion directories with unsafe ownership or permissions. The
# compiled completion dump remains cached under XDG_CACHE_HOME.
typeset -a insecure_completion_dirs
typeset insecure_completion_output
insecure_completion_output="$(compaudit)"
if [[ -n "$insecure_completion_output" ]]; then
  insecure_completion_dirs=("${(@f)insecure_completion_output}")
  print -u2 "Ignoring insecure completion directories:"
  printf '  %s\n' "${insecure_completion_dirs[@]}" >&2
  fpath=("${(@)fpath:|insecure_completion_dirs}")
fi
unset insecure_completion_output
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"
zstyle ':completion:*' menu select

# Case-insensitive: "doc" can complete to "Documents"
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# =========================================================
# Fuzzy finder
# =========================================================

# Distro-agnostic fzf shell integration (fzf >= 0.48). Nix's fzf store path
# is content-hashed, so there's no fixed filesystem path to source like on
# other distros.
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

# =========================================================
# Modular Config Files
# =========================================================

source "$ZDOTDIR/fzf.zsh"
source "$ZDOTDIR/aliases.zsh"
source "$ZDOTDIR/bindings.zsh"
source "$ZDOTDIR/plugins.zsh"
source "$ZDOTDIR/prompt.zsh"


# =========================================================
# Node / NVM
# =========================================================

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"
