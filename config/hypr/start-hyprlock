#!/usr/bin/env bash
set -euo pipefail

# Idempotent: if hyprlock is already up, don't kill+relaunch it, which would
# briefly unlock the session before the new instance takes over.
pgrep -x hyprlock >/dev/null && exit 0

# JPEG instead of grim's default PNG: ~0.06s vs ~2.2s for a 4K capture (PNG's
# lossless encode is the slow part, not the capture itself), and hyprlock
# blurs this heavily anyway so the lossy compression is invisible.
grim -t jpeg "$HOME/.cache/lockscreen.jpg" || { notify-send "Failed to capture lockscreen"; exit 1; }
chmod 600 "$HOME/.cache/lockscreen.jpg"
exec hyprlock
